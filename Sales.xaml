<UserControl x:Class="HISPharmacy.Pharmacy.Sales"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:local="clr-namespace:HISPharmacy.GeneralModules"
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:behaviors="clr-namespace:HISPharmacy.GeneralModules"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    KeyboardNavigation.TabNavigation="Continue"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch" PreviewKeyDown="Sales_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
       
    </UserControl.Resources>

   
        <!-- Design size -->
        <Grid  HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" Background="White">
    <!-- Root border — stretches to fill whatever the host provides -->
    <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Padding="2"
            Background="White" Margin="3,0,3,0"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
 
        <Grid KeyboardNavigation.TabNavigation="Continue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════ TITLE ═══════ -->
            <StackPanel Name="TitlePanel" Grid.Row="0" Visibility="Visible"
                        KeyboardNavigation.TabNavigation="None">
                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1"
                        CornerRadius="10" Padding="2" Background="White" Margin="3">
                    <Grid>
                        <Label Content="Sales" FontSize="16" FontWeight="Bold"
                               Foreground="#17a2b8" VerticalAlignment="Center"
                               Margin="10,0,0,0" IsTabStop="False"/>
                        <Button x:Name="btnNew" Content="+ Add New" Background="#17a2b8"
                                Foreground="White" Height="22" Width="88" FontSize="12"
                                FontWeight="Bold" Cursor="Hand" Margin="0,8,5,9"
                                IsTabStop="False" HorizontalAlignment="Right"
                                Click="btnNew_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══════ SEARCH / LIST ═══════ -->
            <StackPanel Name="GridPanel" Grid.Row="1" Visibility="Visible"
                        KeyboardNavigation.TabNavigation="Continue">
                <Grid Name="grdGrid" KeyboardNavigation.TabNavigation="Continue">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="From Dt."     Margin="3" Grid.Row="1" Grid.Column="0" Width="70" IsTabStop="False"/>
                    <DatePicker                    Margin="3" Grid.Row="1" Grid.Column="1" Name="dtpFrom" Width="150" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="0"/>
                    <Label Content="To Dt."       Margin="3" Grid.Row="1" Grid.Column="2" Width="50" HorizontalAlignment="Right" IsTabStop="False"/>
                    <DatePicker                    Margin="3" Grid.Row="1" Grid.Column="3" Name="dtpTo"   Width="150" HorizontalAlignment="Left" TabIndex="1"/>
                    <Label Content="Patient Name" Margin="3" Grid.Row="1" Grid.Column="4" IsTabStop="False"/>
                    <TextBox x:Name="txtFindBillNo" Grid.Row="1" Grid.Column="5" Margin="3,0,3,0" Width="150" HorizontalAlignment="Left" TabIndex="2"/>
                    <Button  x:Name="btnGo" Content="Go" Background="#17a2b8" Foreground="White"
                             Height="20" Width="50" FontSize="12" FontWeight="Bold" BorderThickness="0"
                             Cursor="Hand" Margin="3" Grid.Row="1" Grid.Column="6"
                             HorizontalAlignment="Left" TabIndex="3" Click="btnGo_Click"/>

                    <DataGrid x:Name="dgvSalesFind" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="7"
                              MinHeight="450" MaxHeight="750" Margin="3"
                              RenderOptions.ClearTypeHint="Enabled" AlternationCount="2"
                              IsReadOnly="True" ScrollViewer.CanContentScroll="True"
                              TextOptions.TextFormattingMode="Display" HeadersVisibility="All"
                              SelectionUnit="FullRow" ItemsSource="{Binding}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              IsTabStop="False" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" RowStyle="{StaticResource GridRowStyle}"> 
                        <DataGrid.Columns>
                            <DataGridTextColumn     Header="SlNo"         Width="50"  Binding="{Binding Slno}"/>
                            <DataGridTemplateColumn Header="View"         Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button ToolTip="View" Click="btnView_Click" Name="btnView"
                                            Padding="0" Width="40" Height="25" BorderThickness="0"
                                            Cursor="Hand" Content="View" Style="{StaticResource GridViewButtonStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Print"        Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button ToolTip="Print" Click="btnPrint_Click" Name="btnPrint"
                                            Padding="0" Width="40" Height="25" BorderThickness="0"
                                            Cursor="Hand" Content="Print" Style="{StaticResource GridPrintButtonStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="UHID"         Width="100" Binding="{Binding UHID}"/>
                            <DataGridTextColumn Header="IPOPNO"       Width="100" Binding="{Binding IPOPNo}"/>
                            <DataGridTextColumn Header="Name"         Width="*"   Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="BillNo"       Width="100" Foreground="Green" Binding="{Binding BillNo}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Bill Date"    Width="110" Binding="{Binding CreateDate, StringFormat=dd-MMM-yyyy}"/>
                            <DataGridTextColumn Header="Total Amount" Width="110" Binding="{Binding Totalcharges}"/>
                            <DataGridTextColumn Header="Discount"     Width="90"  Binding="{Binding Discount}"/>
                            <DataGridTextColumn Header="Paid"         Width="90"  Binding="{Binding Paid}"/>
                            <DataGridTextColumn Header="Due"          Width="90"  Binding="{Binding Due}"/>
                            <DataGridTextColumn Header="Due Auth"     Width="90"  Binding="{Binding DueAuth}"/>
                            <DataGridTextColumn Header="Due Reason"   Width="100" Binding="{Binding DueReason}"/>
                            <DataGridTextColumn Header="Created By"   Width="100" Binding="{Binding CreateUserID}"/>
                            <DataGridTextColumn Header="Department"   Width="100" Binding="{Binding DepartmentName}"/>
                            <DataGridTextColumn Header="Location"     Width="100" Binding="{Binding LocationName}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </StackPanel>

            <!-- ═══════ FORM — scrollable body (Row 2, Height="*") ═══════
                 HorizontalScrollBarVisibility="Disabled" is the critical fix:
                 it prevents the ScrollViewer from giving infinite width to
                 its content, so Width="*" DataGrid columns work correctly.   -->
                <!--<Viewbox Stretch="Fill" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">-->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="FormPanel" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Continue">
 
                    <!-- Sale type + UHID search -->
                    <StackPanel Orientation="Horizontal" Margin="3" KeyboardNavigation.TabNavigation="Continue">
                        <RadioButton x:Name="rdoOP"     Content="OP"     GroupName="SaleTypeGroup"
                                     FontSize="12" Margin="0,0,10,0" TabIndex="0" Checked="rdoOP_Checked"/>
                        <RadioButton x:Name="rdoOthers" Content="Others" GroupName="SaleTypeGroup"
                                     FontSize="12" Margin="0,0,10,0" TabIndex="0" Checked="rdoOthers_Checked"/>
                        <Label Content="UHID/Phone No" FontWeight="Bold" IsTabStop="False"/>
                        <TextBox x:Name="txtUHIDPhone" Height="20" Width="100" TabIndex="1"/>
                        <Button  x:Name="btnFind" Content="Find" Foreground="White"
                                 Height="20" Width="50" FontSize="12" Background="#17a2b8"
                                 FontWeight="Bold" BorderThickness="0" Margin="3,0,3,0"
                                 TabIndex="2" Cursor="Hand" Click="btnFind_Click"/>
                            <Label Content="OPD-F1"                   Margin="3" Foreground="Red" IsTabStop="False"/>
                            <Label Content="Others-F2"                Margin="3" Foreground="Red" IsTabStop="False"/>
                            <Label Content="Search-F6"                Margin="3" Foreground="Red" IsTabStop="False"/>
                            <Label Content="Generic-Shift+F1"         Margin="3" Foreground="Red" IsTabStop="False"/>
                            <Label Content="Department Stock-Shift+F2" Margin="3" Foreground="Red" IsTabStop="False"/>
                        </StackPanel>

                    <!-- ════ PATIENT DETAILS ════ -->
                        <GroupBox Header="Patient Details" Name="grpPatDet" FontWeight="Bold" Margin="5,0,5,0"  KeyboardNavigation.TabNavigation="Continue">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" MinWidth="140" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                <Label Content="Name" IsTabStop="False"/>
                                <TextBox Name="txtName" Height="20" MinWidth="130" TabIndex="3"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="110" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                <Label Content="Age/Gender" IsTabStop="False"/>
                                <TextBox Name="txtAge" Height="20" MinWidth="100" TabIndex="4"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="100" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                <Label Content="Phone No" IsTabStop="False"/>
                                <TextBox Name="txtPhone" Height="20" MinWidth="90" TabIndex="5" MaxLength="10" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="150" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                <Label Content="Doctor" IsTabStop="False"/>
                                <ComboBox Name="cmbDoctor" Height="20" FontSize="12" MinWidth="140"
                                          TabIndex="6" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="140" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                <Label Content="OPDNO" IsTabStop="False"/>
                                <TextBox Name="txtOPDNO" Height="20" MinWidth="130" IsEnabled="False" IsTabStop="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="140" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                <Label Content="UHID" IsTabStop="False"/>
                                <TextBox Name="txtUHID" Height="20" MinWidth="130" IsEnabled="False" IsTabStop="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="100" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                <Label Content="BillNo" IsTabStop="False"/>
                                <TextBox Name="txtBillno" Height="20" MinWidth="90" IsEnabled="False" IsTabStop="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" MinWidth="130" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                <Label Content="BillDt" IsTabStop="False"/>
                                <DatePicker Height="25" Name="dtpBillDt" MinWidth="120"
                                            IsEnabled="False" Foreground="Black" IsTabStop="False"/>
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>

                    <!-- ════ ITEM DETAILS ════ -->
                        <GroupBox Header="Item Details" Name="grpItemDet" FontWeight="Bold" Margin="5,0,5,0" KeyboardNavigation.TabNavigation="Continue">
                        
                        <Grid Name="ItemDet" KeyboardNavigation.TabNavigation="Continue">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Orientation="Horizontal" Grid.Row="0" KeyboardNavigation.TabNavigation="Continue">
                                    <StackPanel Orientation="Vertical" MinWidth="280" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                    <Label Content="Item Name" IsTabStop="False"/>
                                    <TextBox Name="txtItem" MinWidth="270" FontSize="12" Height="23" TabIndex="7"
                                             TextChanged="txtItem_TextChanged"
                                             PreviewKeyDown="txtItem_PreviewKeyDown"
                                             GotFocus="txtItem_GotFocus"
                                             LostFocus="txtItem_LostFocus"/>
                                    <Popup Name="popup"
                                           PlacementTarget="{Binding ElementName=txtItem}"
                                           Placement="Bottom"
                                           IsOpen="{Binding ElementName=popupButton, Path=IsOpen}">
                                        <ListBox x:Name="lstItems" Height="150" Width="300"
                                                 DisplayMemberPath="ItemName"
                                                 ItemsSource="{Binding FilteredItems}"
                                                 PreviewKeyDown="lstItems_PreviewKeyDown"
                                                 MouseDoubleClick="lstItems_MouseDoubleClick"
                                                 LostFocus="lstItems_LostFocus"
                                                 IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="LightBlue"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Popup>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="120" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="Batch No" IsTabStop="False"/>
                                    <ComboBox x:Name="cmbBatchNo" Height="20" FontSize="12" MinWidth="110"
                                              IsTabStop="False" SelectionChanged="cmbBatchNo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="80" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="B.Qty" IsTabStop="False"/>
                                    <TextBox Name="txtBQty" Height="20" MinWidth="70" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="80" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="T.Qty" IsTabStop="False"/>
                                    <TextBox Name="txtTQty" Height="20" MinWidth="70" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="120" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="Exp.Dt" IsTabStop="False"/>
                                    <DatePicker Height="25" Name="dtpExpDt" MinWidth="110"
                                                Foreground="Black" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="80" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                    <Label Content="Issue Qty" IsTabStop="False"/>
                                    <TextBox Name="txtQty" Height="20" MinWidth="70" TabIndex="8"
                                             PreviewKeyDown="txtQty_PreviewKeyDown"
                                             TextChanged="txtQty_TextChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="100" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="MRP" IsTabStop="False"/>
                                    <TextBox Name="txtMRP" Height="20" MinWidth="90" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="150" Margin="3,0,3,0" Visibility="Collapsed" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="Tax Amount" IsTabStop="False"/>
                                    <TextBox Name="txtTaxAmt" MinWidth="140" Height="20" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" MinWidth="110" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="None">
                                    <Label Content="Amount" IsTabStop="False"/>
                                    <TextBox Name="txtAmount" MinWidth="100" Height="20" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Width="80" Margin="3,0,3,0" KeyboardNavigation.TabNavigation="Continue">
                                    <Label Content="" IsTabStop="False"/>
                                    <Button Name="btnAdd" Content="Add" Background="#4CAF50"
                                            Foreground="White" Height="20" FontSize="12"
                                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Width="70" TabIndex="9" Click="btnAdd_Click"/>
                                </StackPanel>
                            </WrapPanel>

                            <DataGrid x:Name="dgvItemDetails" Grid.Row="1"
                                      Height="280" Margin="3,0,3,0"
                                      RenderOptions.ClearTypeHint="Enabled" AlternationCount="2"
                                      IsReadOnly="True" ScrollViewer.CanContentScroll="True"
                                      TextOptions.TextFormattingMode="Display" HeadersVisibility="All"
                                      SelectionUnit="FullRow" ItemsSource="{Binding aItem}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      KeyDown="dgvItemDetails_KeyDown"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      IsTabStop="False"  RowHeaderWidth="0"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"> 
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SlNo"        Width="50"  Binding="{Binding Slno}"/>
                                    <DataGridTextColumn Header="Item Name"   Width="*"   Binding="{Binding ItemName}"/>
                                    <DataGridTextColumn Header="Rack"        Width="70"  Binding="{Binding Rack}"/>
                                    <DataGridTextColumn Header="Tray"        Width="70"  Binding="{Binding Tray}"/>
                                    <DataGridTextColumn Header="BatchNo"     Width="100" Binding="{Binding BatchNo}"/>
                                    <DataGridTextColumn Header="Exp.Dt"      Width="110" Binding="{Binding ExpiryDate, StringFormat=dd-MMM-yyyy}"/>
                                    <DataGridTemplateColumn Header="Qty"     Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     PreviewTextInput="Qty_PreviewTextInput"
                                                     LostFocus="Qty_LostFocus"
                                                     BorderThickness="0.5" BorderBrush="LightGray"
                                                     Padding="2" Margin="2" Height="20"
                                                     TextChanged="Qty_TextChanged">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsQtyHighlighted}" Value="True">
                                                                    <Setter Property="Background" Value="Red"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsQtyHighlighted}" Value="False">
                                                                    <Setter Property="Background" Value="White"/>
                                                                    <Setter Property="Foreground" Value="Black"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MRP"         Width="90"  Binding="{Binding UnitMrp}"/>
                                    <DataGridTextColumn Header="Amount"      Width="90"  Binding="{Binding Amount}"/>
                                    <DataGridTextColumn Header="Discount(%)" Width="100" Binding="{Binding DiscPer}"/>
                                    <DataGridTextColumn Header="Discount"    Width="90"  Binding="{Binding Discount}"/>
                                    <DataGridTextColumn Header="GST"         Width="70"  Binding="{Binding GST}"/>
                                    <DataGridTextColumn Header="ItemId"                  Visibility="Hidden" Binding="{Binding ItemId}"/>
                                    <DataGridTextColumn Header="Rate"                    Visibility="Hidden" Binding="{Binding UnitRate}"/>
                                    <DataGridTextColumn Header="SupplierId"              Visibility="Hidden" Binding="{Binding SupplierID}"/>
                                    <DataGridTextColumn Header="PurchBillNo"             Visibility="Hidden" Binding="{Binding PurchBillNo}"/>
                                    <DataGridTextColumn Header="Bqty"                    Visibility="Hidden" Binding="{Binding BatchQty}"/>
                                    <DataGridTextColumn Header="Stock"                   Visibility="Hidden" Binding="{Binding StockQty}"/>
                                    <DataGridTemplateColumn Header="Delete"  Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button ToolTip="Delete" Click="btnDelete_Click" Name="btnDelete"
                                                    Padding="0" Width="45" Height="25" BorderThickness="0"
                                                    Cursor="Hand" Content="Delete" Style="{StaticResource GridDeleteButtonStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Height" Value="25"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EAF7FA"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#42bff5"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger> 
                                                
                                            <DataTrigger Binding="{Binding IsHigh}"  Value="true">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLook}"  Value="true">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSound}" Value="true">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- ════ PAYMENT DETAILS ════ -->
                        <GroupBox Header="Payment Details" Name="grpPayDet" FontWeight="Bold" Margin="5,0,5,0"
                              KeyboardNavigation.TabNavigation="Continue">
                        <Grid Name="PaymentDet" KeyboardNavigation.TabNavigation="Continue">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Totals (display only) -->
                            <WrapPanel Orientation="Horizontal" Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Total Amount" Width="90" IsTabStop="False"/>
                                    <TextBox Name="txtTotalAmt" Width="100" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Discount" Width="80" IsTabStop="False"/>
                                    <TextBox Name="txtDiscount" Width="100" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Paid Amount" Width="90" IsTabStop="False"/>
                                    <TextBox Name="txtPaidAmt" Width="100" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Due Amount" Width="90" IsTabStop="False"/>
                                    <TextBox Name="txtDueAmt" Width="100" IsEnabled="False" IsTabStop="False"
                                             TextChanged="txtDueAmt_TextChanged"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Due Auth" Width="90" IsTabStop="False"/>
                                    <ComboBox x:Name="cmbDueAuth" Height="20" FontSize="12"
                                              Width="100" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Due Reason" Width="80" IsTabStop="False"/>
                                    <TextBox Name="txtDueReason" Width="250" IsEnabled="False" IsTabStop="False"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Discount entry -->
                            <WrapPanel Orientation="Horizontal" Grid.Row="1">
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Discount Type" Width="90" IsTabStop="False"/>
                                    <ComboBox x:Name="cmbDiscType" Height="20" FontSize="12" Width="100" TabIndex="10"
                                              SelectionChanged="cmbDiscType_SelectionChanged">
                                        <ComboBoxItem Content="--Select--"/>
                                        <ComboBoxItem Content="Percentage"/>
                                        <ComboBoxItem Content="Amount"/>
                                    </ComboBox>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Percentage" Width="80" IsTabStop="False"/>
                                    <TextBox Name="txtConcPer" Width="100" IsEnabled="False"
                                             TabIndex="11" TextChanged="txtConcPer_TextChanged"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Current Disc" Width="90" IsTabStop="False"/>
                                    <TextBox Name="txtConcAmt" Width="100" IsEnabled="False"
                                             TabIndex="12" TextChanged="txtConcAmt_TextChanged"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Discount Auth" Width="90" IsTabStop="False"/>
                                    <ComboBox x:Name="cmbDiscAuth" Height="20" FontSize="12"
                                              Width="100" IsEnabled="False" TabIndex="13"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Disc Reason" Width="90" IsTabStop="False"/>
                                    <TextBox Name="txtDiscReason" Width="250" IsEnabled="False" TabIndex="14"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Payment entry -->
                            <WrapPanel Orientation="Horizontal" Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Pay Amount" Width="90" IsTabStop="False"/>
                                    <TextBox Name="txtPayAmount" Width="100" TabIndex="15"
                                             TextChanged="txtPayAmount_TextChanged"/>
                                </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="3,2,3,2">
                                    <Label Content="Pay Mode" Width="80" IsTabStop="False"/>
                                    <ComboBox x:Name="cmbPayMode" Height="20" FontSize="12" Width="100" TabIndex="16"
                                              DropDownClosed="cmbPayMode_DropDownClosed"/>
                                </StackPanel>
                                <Label Content="Wallet Type" Width="90" Visibility="Collapsed" Name="lblWallet"   Margin="5,0,0,0" IsTabStop="False"/>
                                <ComboBox x:Name="cmbWalletType" Height="20" Margin="3,0,3,0" FontSize="12" Width="100"  Visibility="Collapsed" TabIndex="17"/>
                                <Label Content="Card No"      Width="90" Visibility="Collapsed" Name="lblCardNo"  Margin="5,0,0,0" IsTabStop="False"/>
                                <Label Content="Cheque No"    Width="90" Visibility="Collapsed" Name="lblCheqNo"  Margin="5,0,0,0" IsTabStop="False"/>
                                <Label Content="Reference No" Width="90" Visibility="Collapsed" Name="lblReferenceNo" Margin="5,0,0,0" IsTabStop="False"/>
                                <TextBox Name="txtRefNo" Margin="3,0,3,0" Width="100" Visibility="Collapsed" TabIndex="17"/>
                                <Label Content="Bank"         Width="90" Visibility="Collapsed" Name="lblBank"   Margin="5,0,0,0" IsTabStop="False"/>
                                <ComboBox x:Name="cmbBank" Height="20" Margin="3,0,3,0" FontSize="12" Width="100"       Visibility="Collapsed" TabIndex="18"/>
                                <Label Content="Cheque Dt."   Width="90" Visibility="Collapsed" Name="lblCheqDt" Margin="5,0,0,0" IsTabStop="False"/>
                                <DatePicker Margin="3,0,3,0" Name="dtpCheqDt" Width="120"                               Visibility="Collapsed" TabIndex="19"/>
                                <Button Name="btnPayAdd"   Content="Add"   Background="#4CAF50" Foreground="White"
                                        Height="20" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                        Margin="3,0,3,0" Width="70" TabIndex="20" Click="btnPayAdd_Click"/>
                                <Button Name="btnPayReset" Content="Reset" Background="Red"     Foreground="White"
                                        Height="20" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                        Margin="3,0,3,0" Width="70" IsTabStop="False" Click="btnPayReset_Click"/>
                                <Button Name="btnCalc"     Content="Calc"  Background="#4CAF50" Foreground="White"
                                        Height="20" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                        Margin="3,0,3,0" Width="70" IsTabStop="False" Click="btnCalc_Click"/>
                            </WrapPanel>

                            <!-- Payment DataGrid -->
                            <DataGrid x:Name="dgvPaymentDet" Grid.Row="3" Height="90" Margin="3,0,3,0"
                                      RenderOptions.ClearTypeHint="Enabled" AlternationCount="2"
                                      IsReadOnly="True" ScrollViewer.CanContentScroll="True"
                                      TextOptions.TextFormattingMode="Display" HeadersVisibility="All"
                                      SelectionUnit="FullRow" ItemsSource="{Binding}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      IsTabStop="False"  ColumnHeaderStyle="{StaticResource GridHeaderStyle}" RowStyle="{StaticResource GridRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SlNo"           Width="50"  Binding="{Binding Slno}"/>
                                    <DataGridTextColumn Header="Amount"         Width="*"   Binding="{Binding Amount}"/>
                                    <DataGridTextColumn Header="Pay Mode"       Width="100" Binding="{Binding PayMode}"/>
                                    <DataGridTextColumn Header="Wallet Type"    Width="100" Binding="{Binding WalletAccount}"/>
                                    <DataGridTextColumn Header="Reference No"   Width="120" Binding="{Binding TransNo}"/>
                                    <DataGridTextColumn Header="Reference Bank" Width="120" Binding="{Binding Bank}"/>
                                    <DataGridTextColumn Header="Reference Date" Width="120" Binding="{Binding RefDt}"/>
                                    <DataGridTemplateColumn Header="Delete"     Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button ToolTip="Delete" Click="btnPayDelete_Click" Name="btnPayDelete"
                                                    Padding="0" Width="45" Height="25" BorderThickness="0"
                                                    Cursor="Hand" Content="Delete"
                                                   Style="{StaticResource GridDeleteButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                        <StackPanel Orientation="Horizontal" Grid.Row="6" Margin="10" KeyboardNavigation.TabNavigation="Continue">
                            <Label Content="Transaction Code" Width="120" FontWeight="Bold"
                           VerticalAlignment="Center" IsTabStop="False"/>
                            <TextBox Name="txtTrnsCode" Height="22" Width="110"
                             VerticalAlignment="Center" TabIndex="23"/>
                            <Button Name="btnSave" Content="Save" Background="#4CAF50"
                            Foreground="White" Height="22" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Width="75"
                            TabIndex="24" VerticalAlignment="Center" Click="btnSave_Click"/>
                            <Button Name="btnReset" Content="Reset" Background="Red"
                            Foreground="White" Height="22" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Width="75"
                            TabIndex="25" VerticalAlignment="Center" Click="btnReset_Click"/>
                        </StackPanel>
                    </StackPanel>
            </ScrollViewer>

           
            <Popup Name="UHIDPopUp" Placement="MousePoint" IsOpen="False"
                   Height="400" Width="650" Visibility="Collapsed">
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="1"
                                    KeyboardNavigation.TabNavigation="Continue">
                            <Label Content="From Dt." Margin="3,0,3,0" Width="70" IsTabStop="False"/>
                            <DatePicker Margin="3,0,3,0" Name="dtpUHIDFrom" Width="150" TabIndex="0"/>
                            <Label Content="To Dt."   Margin="3,0,3,0" Width="50" IsTabStop="False"/>
                            <DatePicker Margin="3,0,3,0" Name="dtpUHIDTo"   Width="150" TabIndex="1"/>
                            <Button x:Name="btnUHIDGo" Content="Go" Foreground="White"
                                    Height="25" Width="50" FontSize="12" FontWeight="Bold"
                                    Background="#17a2b8" BorderThickness="0" Cursor="Hand"
                                    Margin="3,0,3,0" TabIndex="2" Click="btnUHIDGo_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="dgvPatientDetails" Height="300" Margin="3,0,3,0" Grid.Row="2"
                                  RenderOptions.ClearTypeHint="Enabled" AlternationCount="2"
                                  IsReadOnly="True" ScrollViewer.CanContentScroll="True"
                                  TextOptions.TextFormattingMode="Display" HeadersVisibility="All"
                                  SelectionUnit="FullRow" ItemsSource="{Binding}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsTabStop="False" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" RowStyle="{StaticResource GridRowStyle}">                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SLNO"        Width="50"  Binding="{Binding Slno}"/>
                                <DataGridTextColumn Header="UHID"        Width="*"   Binding="{Binding UHID}"/>
                                <DataGridTextColumn Header="OPDNO"       Width="110" Binding="{Binding OPDNO}"/>
                                <DataGridTextColumn Header="Name"        Width="160" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Phone"       Width="100" Binding="{Binding Phone}"/>
                                <DataGridTextColumn Header="Consultant"  Width="140" Binding="{Binding DocName}"/>
                                <DataGridTextColumn Header="Consult Dt"  Width="100" Binding="{Binding CreateDate, StringFormat=dd-MMM-yyyy}"/>
                                <DataGridTextColumn Header="Payer"       Width="100" Binding="{Binding OrganisationName}"/>
                                <DataGridTextColumn Header="DocId"           Visibility="Hidden" Binding="{Binding DocId}"/>
                                <DataGridTextColumn Header="RefSourceID"     Visibility="Hidden" Binding="{Binding RefSourceID}"/>
                                <DataGridTextColumn Header="OrganisationID"  Visibility="Hidden" Binding="{Binding OrganisationID}"/>
                                <DataGridTextColumn Header="Age"             Visibility="Hidden" Binding="{Binding Age}"/>
                                <DataGridTextColumn Header="PrescriptionID"  Visibility="Hidden" Binding="{Binding PrescriptionID}"/>
                                <DataGridTemplateColumn Header="View" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button ToolTip="View" Click="btnUHIDView_Click" Name="btnUHIDView"
                                                Background="Transparent" Cursor="Hand" Content="View"
                                                Style="{StaticResource GridViewButtonStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="3,0,3,0"
                                    KeyboardNavigation.TabNavigation="Continue">
                            <Button x:Name="btnBackUHID" Content="Back" Background="#f44336"
                                    Foreground="White" Height="25" Width="70" FontSize="12"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                    TabIndex="3" Click="btnBackUHID_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Popup>

        </Grid>
            </Border>
        </Grid> 
</UserControl>
