<UserControl x:Class="HISPharmacy.Pharmacy.OPSaleReturn"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"             
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:HISPharmacy.GeneralModules"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:behaviors="clr-namespace:HISPharmacy.GeneralModules"
        mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro.Resources;component/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <SolidColorBrush x:Key="brushWatermarkBackground" Color="White" />
            <SolidColorBrush x:Key="brushWatermarkForeground" Color="LightSteelBlue" />
            <SolidColorBrush x:Key="brushWatermarkBorder" Color="Indigo" />
            <Thickness x:Key="ControlMargin">0 5 5 0</Thickness>
            <Style x:Key="UnderlinedButtonStyle" TargetType="Button">
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextDecorations="Underline" Background="Transparent" Foreground="Blue" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>

    <ScrollViewer>
        <Border BorderBrush="Gray"  BorderThickness="2" CornerRadius="10" Padding="2"
                Background="White" Margin="5"  >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Name="TitlePanel" Visibility="Visible" Grid.Row="0" >
                    <Border BorderBrush="LightGray"  BorderThickness="0,0,0,1" CornerRadius="10" Padding="2" Background="White" Margin="5">
                        <Grid Name="grdTitle">
                            <Button x:Name="btnNew" Content="+ Add New" Background="#17a2b8" Foreground="White" Height="22" Width="88" FontSize="12"
                                FontWeight="Bold"  Cursor="Hand" Margin="0,8,5,9" Grid.Row="0" 
                              TabIndex="5" Click="btnNew_Click" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Name="GridPanel" Visibility="Visible" Grid.Row="1">
                    <Grid Name="grdGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Content="From Dt." Margin="5" Grid.Row ="1" Grid.Column="0" Width="70" />
                        <DatePicker Margin="5" Grid.Row ="1" Grid.Column="1" Name="dtpFrom" Width="150" 
                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Label Content="To Dt." Margin="5" Grid.Row ="1" Grid.Column="2" Width="50" HorizontalAlignment="Right" />
                        <DatePicker Margin="5" Grid.Row ="1" Grid.Column="3" Name="dtpTo" Width="150" 
                         HorizontalAlignment="Left" />
                        <Label Content="Patient Name" Margin="5" Grid.Row ="1" Grid.Column="4" />
                        <TextBox x:Name="txtFindBillNo" Grid.Row="1" Grid.Column="5" Margin="5,5,5,5" Width="150" HorizontalAlignment="Left"  ></TextBox>
                        <Button x:Name="btnGo" Content="Go" Background="#17a2b8" Foreground="White" Height="20" Width="50" FontSize="12"
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="5,5,5,5" Grid.Row="1" Grid.Column="6" 
                          TabIndex="5" Click="btnGo_Click" HorizontalAlignment="Left"></Button>

                        <DataGrid x:Name="dgvSalesRetFind" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="7" Height="750" Margin="5" 
                            RenderOptions.ClearTypeHint="Enabled"  AlternationCount="2" IsReadOnly="True" ScrollViewer.CanContentScroll="True"
                            TextOptions.TextFormattingMode="Display" HeadersVisibility="All" SelectionUnit="FullRow" ItemsSource="{Binding}" 
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"   VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1EAAC7"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderBrush" Value="Gray"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="SlNo" Width="50" 
                                    Binding="{Binding Slno}" />
                                <DataGridTemplateColumn Header="View" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button ToolTip="View" Click="btnView_Click"  Name="btnView" Padding="0" 
                                                Width="30" Height="25" BorderThickness="0" Cursor="Hand" Content="View" Style="{StaticResource UnderlinedButtonStyle}">
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Print" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button ToolTip="Print" Click="btnPrint_Click"  Name="btnPrint" Padding="0" Style="{StaticResource UnderlinedButtonStyle}"
                                      Width="30" Height="25" BorderThickness="0" Cursor="Hand" Content="Print">
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="UHID" Width="100" 
                                    Binding="{Binding UHID}"  />
                                <DataGridTextColumn Header="IPOPNO" Width="100"
                                    Binding="{Binding IPOPNo}" />
                                <DataGridTextColumn Header="Name" Width="150"
                                    Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="BillNo" Width="100" Foreground="Green"
                                    Binding="{Binding BillNo}" />
                                <DataGridTextColumn Header="Bill Date"  Width="100"
                                    Binding="{Binding CreateDate, StringFormat=dd-MMM-yyyy}"/>
                                <DataGridTextColumn Header="Total Amount"  Width="100" 
                                    Binding="{Binding Totalcharges}" />
                                <DataGridTextColumn Header="Discount"  Width="100"
                                    Binding="{Binding Discount}" />
                                <DataGridTextColumn Header="Paid"  Width="100"
                                    Binding="{Binding Paid}" />
                                <DataGridTextColumn Header="Due"  Width="100"
                                    Binding="{Binding Due}" />
                                <DataGridTextColumn Header="Due Auth"  Width="100"
                                    Binding="{Binding DueAuth}" />
                                <DataGridTextColumn Header="Due Reason"  Width="100"
                                    Binding="{Binding DueReason}" />
                                <DataGridTextColumn Header="Created By" Width="100" 
                                    Binding="{Binding CreateUserID}" />
                                <DataGridTextColumn Header="Department"  Width="100"
                                    Binding="{Binding DepartmentName}" />
                                <DataGridTextColumn Header="Location"  Width="100"
                                    Binding="{Binding LocationName}" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </StackPanel>

                <ScrollViewer x:Name="scrollFormPanel"  VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Disabled" Grid.Row="2" Height="700">
                    <StackPanel Name="FormPanel" Visibility="Collapsed" >
                        <Grid Name="grdForm">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="1">
                                <Label Content="OPD-F1"   Foreground="Red" HorizontalAlignment="Left" />
                                <Label Content="Others-F2"   Foreground="Red" HorizontalAlignment="Left" />
                                <Label Content="Search-F6"  Foreground="Red" HorizontalAlignment="Left" />
                                <Label Content="Generic-Shift+F1" Foreground="Red" HorizontalAlignment="Left" />
                                <Label Content="Department Stock-Shift+F2" Foreground="Red" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="2">                               
                                <Label Content="Bill No"  HorizontalAlignment="Left" FontWeight="Bold" />
                                <TextBox x:Name="txtUHIDPhone" Height="20" HorizontalAlignment="Left"  Width="100"  TabIndex="2" ></TextBox>
                                <Button x:Name="btnFind" Content="Find" Foreground="White" Height="20" Width="50" FontSize="12" Background="#17a2b8"
                              FontWeight="Bold" BorderThickness="0" Margin="5" TabIndex="3" Cursor="Hand" Click="btnFind_Click"  HorizontalAlignment="Left"></Button>
                            </StackPanel>
                            <GroupBox Header="Patient Details" Name="grpPatDet" Grid.Row="3" FontWeight="Bold" Margin="5" Height="185">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="120"/>

                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="200"/>

                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="200"/>
                                        
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>


                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column 1 -->
                                    <Label Grid.Row="0" Grid.Column="0" Content="UHID/OPDNo:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="0" Grid.Column="1" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Name="lblUHID" VerticalAlignment="Center"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Name:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="1" Grid.Column="1" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Name="NameLabel" VerticalAlignment="Center"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Age/Gender:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="1" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Name="AgeGenderLabel" VerticalAlignment="Center"/>
                                    
                                    <Label Grid.Row="3" Grid.Column="0" Content="Phone No:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="3" Grid.Column="1" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Name="PhoneLabel" VerticalAlignment="Center"/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="Email:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="4" Grid.Column="1" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Name="EmailLabel" VerticalAlignment="Center"/>

                                    <Label Grid.Row="5" Grid.Column="0" Content="Address:" VerticalAlignment="Top"/>
                                    <Label Grid.Row="5" Grid.Column="1" Content=":" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Name="AddressLabel" TextWrapping="Wrap"/>

                                    <!-- Column 2 -->
                                    <Label Grid.Row="0" Grid.Column="3" Content="BillNo:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="0" Grid.Column="4" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="5" Name="BillLabel" VerticalAlignment="Center"/>

                                    <Label Grid.Row="1" Grid.Column="3" Content="Bill Date:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="1" Grid.Column="4" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="5" Name="BillDtLabel" VerticalAlignment="Center"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Guardian:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="1" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Name="GuardianLabel" VerticalAlignment="Center"/>

                                    <Label Grid.Row="5" Grid.Column="3" Content="Payer:" VerticalAlignment="Center"/>
                                    <Label Grid.Row="5" Grid.Column="4" Content=":" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="5" Grid.Column="5" Name="PayerLabel" VerticalAlignment="Center"/>
                                  
                                  
                                    <TextBlock Name="DocIDLabel" Visibility="Collapsed"/>
                                    <TextBlock Name="OrgIDLabel" Visibility="Collapsed"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </ScrollViewer>
    
</UserControl>
