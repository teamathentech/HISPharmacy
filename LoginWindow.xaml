<Window x:Class="HISPharmacy.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - ATHENTECH SAHASRA HIS GenX"
        Icon="WINRX_ATH.ico"
        WindowStartupLocation="CenterScreen" 
        Width="420"
        Height="360"
        Background="Honeydew"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Border Background="White"
                CornerRadius="12"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Padding="30"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid KeyboardNavigation.TabNavigation="Continue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Login"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#007ACC"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Text="User ID"
                           FontWeight="Bold"/>

                <TextBox x:Name="txtUserName"
                         Grid.Row="2"
                         Margin="100,0,0,0"
                         Height="30"
                         FontSize="14"
                         TabIndex="1"
                         TextChanged="txtUserName_TextChanged"/>

                <TextBlock Grid.Row="4"
                           Text="Password"
                           FontWeight="Bold"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="4"
                             Margin="100,0,0,0"
                             Height="30"
                             FontSize="14"
                             TabIndex="2"/>

                <TextBlock Grid.Row="6"
                           Text="Location"
                           FontWeight="Bold"/>

                <ComboBox x:Name="cmbLocation"
                          Grid.Row="6"
                          Margin="100,0,0,0"
                          Height="30"
                          FontSize="14"
                          TabIndex="3"/>

                <TextBlock Grid.Row="8"
                           Text="Department"
                           FontWeight="Bold"/>

                <ComboBox x:Name="cmbDepartment"
                          Grid.Row="8"
                          Margin="100,0,0,0"
                          Height="30"
                          FontSize="14"
                          TabIndex="4"/>

                <Button x:Name="btnLogin"
                        Grid.Row="10"
                        Content="Login"
                        Background="#4CAF50"
                        Foreground="White"
                        Height="35"
                        Width="120"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        TabIndex="5"
                        Click="btnLogin_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>